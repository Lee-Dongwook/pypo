# Triplestore
TRIPLESTORE_URL=http://localhost:7878
TRIPLESTORE_QUERY_ENDPOINT=/query
TRIPLESTORE_UPDATE_ENDPOINT=/update

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# Search subgraph model: "provider:model" (provider alone uses the default model)
SEARCH_MODEL=openai:gpt-4.1-mini

# pypo (AI 동료) model. Default is local Ollama (free).
DEVBOT_MODEL=ollama:qwen2.5-coder:7b
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...

# Database
DATABASE_URL=postgresql+psycopg://pypo:pypo@localhost:5432/pypo

# Redis
REDIS_URL=redis://localhost:6379/0
