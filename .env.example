# .env.example
# Triplestore (Oxigraph)
TRIPLESTORE_URL=http://localhost:7878
TRIPLESTORE_QUERY_ENDPOINT=/query
TRIPLESTORE_UPDATE_ENDPOINT=/update

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Postgres/Redis (있어도 일단은 나중에 씀)
DATABASE_URL=postgresql+psycopg://pypo:pypo@localhost:5432/pypo
REDIS_URL=redis://localhost:6379/0
